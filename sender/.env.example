# Copy this file to .env and fill the real values there.
# Do not commit .env and do not paste secrets into chats or issues.

WORKER_BASE_URL=
ZOOM_ONLY_SECRET=
ZOOM_MEETING_URL=
ZOOM_DISPLAY_NAME=Нафаня (бот)

ZOOM_SENDER_DRY_RUN=true
ZOOM_SENDER_MOCK_OUTBOX=false
ZOOM_SENDER_MOCK_MESSAGE=Dry-run Zoom message
# Read-only DOM diagnostics for future incoming chat support. Does not call webhook or change queues.
ZOOM_SENDER_CHAT_READONLY_DIAGNOSTICS=false
# Safely replace Nafanya's own queue/speaker-state messages after the new state is verified.
ZOOM_SENDER_REPLACE_OWN_STATE_MESSAGES=false
# Leave empty for production. A test meeting ID selects its isolated Worker outbox.
ZOOM_SENDER_OUTBOX_MEETING_ID=
ZOOM_TEAM_CHAT_TEST_ENABLED=false
ZOOM_TEAM_CHAT_TEST_PAUSED=true
ZOOM_TEAM_CHAT_TEST_MEETING_IDS=
HEADLESS=true
# One-time Zoom account authorization mode. Put real credentials only in .env on the server.
ZOOM_AUTH_SETUP=false
ZOOM_AUTH_EMAIL=
ZOOM_AUTH_PASSWORD=
ZOOM_AUTH_WAIT_FOR_MANUAL=false
ZOOM_CONTROL_TOKEN=
ZOOM_PANEL_TOKEN=
# Zoom Marketplace app credentials. Keep both values only in the server .env.
ZOOM_APP_CLIENT_SECRET=
ZOOM_APP_SESSION_SECRET=
ZOOM_CONTROL_HOST=127.0.0.1
ZOOM_CONTROL_PORT=3098
# Absolute server path. It must be the same inside the control-agent container.
ZOOM_CONTROL_PROJECT_HOST_PATH=/home/masha/nafanya-zoom-sender
ZOOM_AUTH_WAIT_MS=600000
ZOOM_AUTH_VIEW_ENABLED=false
# Extra Chromium flags, separated by spaces. Usually leave empty.
ZOOM_SENDER_BROWSER_ARGS=
ZOOM_SENDER_MIN_POLL_MS=1500
ZOOM_SENDER_MAX_POLL_MS=1500
ZOOM_SENDER_ERROR_POLL_MS=10000
# Restart a stuck Zoom page after 3 minutes; a detected waiting room is exempt.
ZOOM_SENDER_RECOVERY_AFTER_MS=180000
ZOOM_SENDER_OUTBOX_LIMIT=20
# In Docker this should listen on all container interfaces; compose still exposes it only on 127.0.0.1 outside.
ZOOM_SENDER_HEALTH_HOST=0.0.0.0
ZOOM_SENDER_HEALTH_PORT=3097
ZOOM_SENDER_USER_DATA_DIR=/app/profile
ZOOM_SENDER_DIAGNOSTICS_DIR=
