{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nafanya-zoom-worker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_INSTANCE_ID": "default",
    "ZOOM_TEAM_CHAT_TEST_ENABLED": "false",
    "ZOOM_TEAM_CHAT_TEST_MEETING_IDS": "",
    "ZOOM_TEAM_CHAT_CLIENT_ID": "",
    "ZOOM_TEAM_CHAT_REDIRECT_URI": ""
  },
  "r2_buckets": [
    {
      "binding": "ZOOM_LIBRARY",
      "bucket_name": "nafanya-zoom-library"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ZOOM_MEETING_STATE",
        "class_name": "ZoomMeetingState"
      },
      {
        "name": "ZOOM_SHARED_TIMER_STATE",
        "class_name": "ZoomSharedTimerState"
      },
      {
        "name": "ZOOM_TEAM_CHAT_STATE",
        "class_name": "ZoomTeamChatState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ZoomMeetingState", "ZoomSharedTimerState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ZoomTeamChatState"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
