{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nafanya-zoom-worker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_INSTANCE_ID": "default"
  },
  "r2_buckets": [
    {
      "binding": "ZOOM_LIBRARY",
      "bucket_name": "nafanya-zoom-library"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ZOOM_MEETING_STATE",
        "class_name": "ZoomMeetingState"
      },
      {
        "name": "ZOOM_SHARED_TIMER_STATE",
        "class_name": "ZoomSharedTimerState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ZoomMeetingState", "ZoomSharedTimerState"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
